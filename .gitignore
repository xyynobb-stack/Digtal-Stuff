.DS_Store
.idea/

# Dependencies
node_modules/

# Build output
dist/
out/

# TypeScript incremental build info
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.*
!.env.example

# ESLint cache
.eslintcache

# Local isolated Hermes homes for development/tests
.sandbox/

# Electron packaging artifacts
release/
.claude/worktrees

# Generated from resources/employee-default-soul.md by the offline runtime
# staging script. The source template, not this generated copy, is versioned.
/build/offline-runtime/employee-default-soul.md

# Generated from the builder's local Hermes environment. This contains an
# administrator credential and must never be committed.
/build/offline-runtime/employee-lookup.env

# Downloaded by prepare-portable-git.mjs for local and CI packaging. The full
# PortableGit distribution is generated build input, not repository source.
/build/offline-runtime/git/

# Tauri
**/src-tauri/target/
**/src-tauri/gen/
**/src-tauri/WixTools/

# Local launcher scripts (user-specific, do not commit)
/*.bat
/*.ps1
.mcp.json
